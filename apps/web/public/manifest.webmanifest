{
  "name": "Stock Assistant",
  "short_name": "StockAI",
  "description": "Personal stock analysis and trading assistant",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "background_color": "#f4f8ff",
