APP_NAME=stock-assistant-api
APP_ENV=dev
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
API_BASE_URL=http://api:8000

POSTGRES_DB=stock_assistant
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

LOG_LEVEL=INFO
# DATABASE_URL is optional for local smoke: defaults to <repo>/data/aistock.local.sqlite3
# Set DATABASE_URL explicitly for an existing database or production deployment.
MARKET_DATA_PROVIDER=akshare
# real (default): fail if provider missing/unreachable. NEVER synthesize prices.
# mock: explicitly opt in for a non-production DEMO only.
MARKET_DATA_MODE=real
BROKER_PROVIDER=mock
